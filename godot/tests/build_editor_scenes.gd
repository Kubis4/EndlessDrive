extends SceneTree
## One-off migration. Refuses to replace existing authored files.
## Normal editor startup and gameplay NEVER call this script.

var failed := false

func _initialize() -> void:
	call_deferred("_build")


func _build() -> void:
	for directory: String in ["res://scenes/ui", "res://scenes/world", "res://assets/models/stops"]:
		DirAccess.make_dir_recursive_absolute(directory)
	var hud := DriveHUD.new()
	hud.name = "HUD"
	hud.process_mode = Node.PROCESS_MODE_ALWAYS
	hud._build_layout()
	AuthoredLayout.annotate(hud)
	hud.set_meta("authored_layout", true)
	hud._speed.text = "000"
	hud._loot_capacity.text = "12.5 / 230 kg\n4 / 10 miest"
	hud._loot_selection.text = "Označ zásoby, ktoré chceš vziať."
	hud._cargo_info.text = "KUFOR · zásoby a náhradné diely aktuálnej jazdy"
	hud._component_info.text = "Vyber diel na schéme auta."
	hud._stop_service_info.text = "Platené služby sú dostupné pri príslušnej budove."
	_save(hud, "res://scenes/ui/hud.tscn")
	hud.free()
	var menu := DriveMenu.new()
	menu.name = "MainMenu"
	menu._ensure_built()
	var body := menu._modal_body
	for kind: String in ["settings", "howto", "garage", "new", "quit", "upgrades"]:
		var panel := VBoxContainer.new()
		panel.name = kind.to_pascal_case()
		panel.size_flags_vertical = Control.SIZE_EXPAND_FILL
		panel.add_theme_constant_override("separation", 16)
		body.add_child(panel)
		menu._modal_body = panel
		match kind:
			"settings": menu._build_settings()
			"howto": menu._build_howto()
			"garage": menu._build_garage()
			"new": menu._build_confirmation(false)
			"quit": menu._build_confirmation(true)
			"upgrades": menu._build_upgrades()
		menu._panels[kind] = panel
		panel.hide()
	menu._modal_body = body
	menu._root.show()
	menu.visible = true
	AuthoredLayout.annotate(menu)
	menu.set_meta("authored_layout", true)
	_save(menu, "res://scenes/ui/main_menu.tscn")
	menu.free()
	for kind: String in DriveStops.KINDS:
		var model := StopModels.create(kind)
		_save(model, "res://assets/models/stops/" + kind + ".tscn")
		model.free()
	_build_camp()
	await _build_overview()
	quit(1 if failed else 0)


func _build_camp() -> void:
	var camp := Node3D.new()
	camp.name = "StartCamp"
	var workshop := load("res://assets/models/stops/workshop.tscn").instantiate() as Node3D
	workshop.name = "Workshop"
	camp.add_child(workshop)
	for entry: Array in [["mesa_rock", Vector3(-7, -0.2, -3)], ["desert_scrub", Vector3(6, 0, 2)], ["saguaro", Vector3(7.7, 0, -2.8)]]:
		var prop := load("res://assets/models/" + str(entry[0]) + ".tscn").instantiate() as Node3D
		prop.position = entry[1]
		camp.add_child(prop)
	_save(camp, "res://scenes/world/start_camp.tscn")
	camp.free()


func _build_overview() -> void:
	var world := DriveWorld.new()
	root.add_child(world)
	world.configure(24601)
	# Just the local stretch: saved once, not regenerated by the editor.
	for index in [-1, 0, 1]: world._create_chunk(index)
	var preview := Node3D.new()
	preview.name = "EditorTerrainPreview"
	preview.set_script(load("res://scripts/editor_preview.gd"))
	for chunk: Node in world.get_children():
		world.remove_child(chunk)
		preview.add_child(chunk)
	# Strip collision and keep native mesh/prop nodes. Avoid baking GPU batch IDs.
	_strip_preview(preview)
	_save(preview, "res://scenes/world/editor_terrain.tscn")
	preview.free()
	world.free()


func _strip_preview(node: Node) -> void:
	if node.has_meta("prop_batches"): node.remove_meta("prop_batches")
	for child: Node in node.get_children():
		if child is CollisionObject3D or str(child.name).begins_with("Building_"):
			node.remove_child(child)
			child.free()
		else: _strip_preview(child)


func _save(node: Node, path: String) -> void:
	if FileAccess.file_exists(path):
		print("PRESERVED existing authored scene: ", path)
		return
	_readable_names(node)
	_owners(node, node)
	var scene := PackedScene.new()
	var error := scene.pack(node)
	if error == OK: error = ResourceSaver.save(scene, path)
	if error != OK:
		failed = true
		push_error("Cannot save " + path + ": " + error_string(error))
	else: print("AUTHORED ", path)


func _readable_names(node: Node) -> void:
	for child: Node in node.get_children():
		if str(child.name).contains("@"):
			var label := child.get_class()
			if child is Button or child is Label:
				label = str(child.text).split("\n")[0].validate_node_name().substr(0, 40).to_pascal_case()
			if label.is_empty(): label = child.get_class()
			child.name = label
		_readable_names(child)


func _owners(node: Node, scene_root: Node) -> void:
	for child: Node in node.get_children():
		child.owner = scene_root
		# Preserve nested packed scenes as linked instances, not flattened copies.
		if child.scene_file_path.is_empty(): _owners(child, scene_root)
