extends SceneTree
## Physical recovery, reachable storm cover, restart semantics and live language.
var failures := 0
func _initialize() -> void: call_deferred("_run")
func check(ok: bool, title: String) -> void:
	if not ok: failures += 1
	print("%s %s" % ["PASS" if ok else "FAIL", title])
func frames(count: int) -> void:
	for tick in count:
		await physics_frame
		await process_frame
func _run() -> void:
	var game := load("res://scenes/main.tscn").instantiate() as Node3D
	game._ephemeral = true
	root.add_child(game)
	var car: DriveVehicle = game.vehicle
	var world: DriveWorld = game.world
	game.weather.forced_mode = "Jasno"
	await frames(12)
	check(car.get_node_or_null("WinchMount/CableOutlet") != null, "The authored vehicle contains an editable visible winch mount")
	# Isolate cable selection from procedural props for repeatable line-of-sight checks.
	for anchor: Node in get_nodes_in_group("winch_anchor"): anchor.remove_from_group("winch_anchor")
	var target := Marker3D.new()
	target.position = car.position + Vector3(11.0, 0.6, 0)
	target.add_to_group("winch_anchor")
	game.add_child(target)
	car.heading = 0
	car.park()
	car.controls_enabled = true
	game.run.engine_running = false
	var before := car.position
	var battery: float = game.run.battery
	game.winch.toggle_attachment()
	check(game.winch.anchor_node() == target, "Cable attaches to a real visible anchor within its reach")
	game.winch.toggle_reel()
	await frames(120)
	check(car.position.x > before.x + 1.2 and game.run.battery < battery - 0.004, "Reeling physically pulls the car and consumes battery")
	check(car.position.y > world.height_at(car.position.x, car.position.z) - 0.5 and car.boundary_recoveries == 0, "Recovery retains terrain collisions without rescue teleports")
	game._action("pause")
	check(not game.winch.reeling and car.winch_pull_velocity == Vector3.ZERO and game.winch.anchor_node() == target, "Opening a menu stops the motorized pull while retaining the attachment")
	game._action("resume")
	game.winch.disconnect_cable()
	check(car.winch_pull_velocity == Vector3.ZERO and not game.winch.reeling, "Disconnect releases all winch pull")
	var wall := StaticBody3D.new()
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(0.6, 5, 5)
	shape.shape = box
	wall.add_child(shape)
	wall.position = (car.position + target.position) * 0.5 + Vector3.UP
	game.add_child(wall)
	await frames(3)
	game.winch.toggle_attachment()
	check(game.winch.anchor_node() == null, "A wall obstructs the cable rather than allowing recovery through it")
	wall.queue_free()
	target.queue_free()
	# Refuges are generated by streaming, and weather may only chase near one.
	world.configure(24601)
	world.update_stream(0)
	car.park()
	car.position = Vector3(0, world.height_at(0, world.center_at(0)) + 0.6, world.center_at(0))
	var refuge: Dictionary = world.find_shelter(car.position, 360.0, true)
	check(not refuge.is_empty(), "The starting desert has reachable loaded storm cover ahead")
	var legacy_run := DriveRun.new()
	legacy_run.weather_state = {"left": 20.0, "edge": car.position.x + 30.0}
	var legacy_weather := DriveWeather.new()
	legacy_weather.run = legacy_run
	legacy_weather.world = world
	legacy_weather.vehicle = car
	game.add_child(legacy_weather)
	legacy_weather.set_process(false)
	check(legacy_weather.has_shelter_target and is_equal_approx(legacy_weather.storm_warning, 20.0) and legacy_weather.storm_edge < car.position.x - 100, "An old saved storm migrates to reachable cover with renewed preparation time")
	legacy_weather.queue_free()
	game.weather.forced_mode = ""
	game.weather.reset_weather()
	game.weather._next_storm = 0
	game.weather._process(0.1)
	check(game.weather.storm_active and game.weather.has_shelter_target and game.weather.storm_warning > 19.0 and game.weather.storm_warning <= 20.0, "A dust chase starts with an actual shelter and a fair advance warning")
	game.weather.shelter_target = Vector3(999999.0, 0, 0)
	game.weather.storm_warning = 7.0
	game.weather._shelter_check = 0
	game.weather._process(0.1)
	check(game.weather.has_shelter_target and game.weather.shelter_target.x < 400.0 and game.weather.storm_warning <= 7.0, "A changed shelter does not restart the twenty-second warning")
	var health: float = game.run.parts.radiator
	game.weather.storm_edge = car.position.x + 20
	game.weather._process(1.0)
	check(game.run.parts.radiator == health, "The warning period does not damage an exposed car")
	if not refuge.is_empty():
		car.position = refuge.position + Vector3.UP * 0.6
		game.weather._refresh_shelter()
		game.weather.storm_warning = 0
		# The current front is two-dimensional; storm_edge is legacy telemetry.
		game.weather.storm_center = Vector2(car.position.x, car.position.z)
		game.weather._storm_left = game.weather._storm_duration - 20.0
		game.weather.storm_visibility = 1.0
		game.weather._process(1.0)
		check(game.weather.sheltered and game.run.parts.radiator == health, "Entering the real roof footprint protects the radiator from dust")
		car.position.z = world.center_at(car.position.x)
		car.position.y = world.height_at(car.position.x, car.position.z) + 0.6
		game.weather._process(1.0)
		if game.run.parts.radiator >= health:
			print("STORM EXPOSURE active=%s warning=%.2f visibility=%.2f sheltered=%s target=%s" % [game.weather.storm_active, game.weather.storm_warning, game.weather.storm_visibility, game.weather.sheltered, game.weather.shelter_target])
		check(not game.weather.sheltered and game.run.parts.radiator < health, "Leaving cover exposes the car to the same storm")
	var restored := DriveRun.from_data(game.run.to_data())
	check(restored != null and restored.weather_state == game.run.weather_state, "Warning and shelter target persist with the weather front")
	var seed: int = game.run.world_seed
	game.run.distance = 2200
	game._action("restart")
	check(game.run.world_seed == seed and game.run.distance == 0 and car.position.x == 0 and not game.run.engine_running, "Restart begins the same route from zero with a stopped car")
	game._settings_changed("language", 1.0)
	check(TranslationServer.get_locale().begins_with("en") and TranslationServer.translate("Reštartovať cestu") != "Reštartovať cestu", "English setting changes actual translated UI strings")
	game._settings_changed("language", 0.0)
	check(TranslationServer.get_locale().begins_with("sk"), "The language can be switched back without restarting")
	game.queue_free()
	await process_frame
	quit(1 if failures else 0)
