; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Endless Drive"
config/description="Endless road from the fields to the mountains: fuel, loot, scrap and a garage."
config/version="1.6.0"
run/main_scene="res://offroad/endless_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.098, 0.11, 0.098, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/handheld/orientation=4
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level.mobile=1
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.11, 0.16, 0.19, 1)
