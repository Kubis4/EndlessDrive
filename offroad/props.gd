## Ground layers of highlands_ground.gdshader (texture array order) and the
## ground kinds drawn with each.
const GROUND_LAYERS := ["grass", "forest", "dirt", "mud", "gravel", "rock", "bank", "trail_mud", "snow", "ice", "sand", "ploughed"]
## Plants generated by build_crops.gd: name → trunk radius for collision.
const MADE := {"pine_1": 0.22, "pine_2": 0.2, "cactus_1": 0.26, "cactus_2": 0.2, "shrub_dry": 0.0, "reeds": 0.0, "weeds": 0.0,
	# From the foliage sources (build_foliage.gd).
	"pack_wheatgrass": 0.0, "pack_buffalo": 0.0, "pack_longgrass": 0.0, "pack_phlox": 0.0, "pack_yarrow": 0.0, "pack_blanketflower": 0.0, "pack_beardtongue": 0.0,
	"crop_wheat": 0.0, "crop_sunflower_1": 0.0, "crop_sunflower_2": 0.0, "crop_sunflower_3": 0.0}

static func names(prefix: String) -> Array:
	return MODELS.keys().filter(func(n: String): return n.begins_with(prefix))

## Every placeable model, the pack's and the generated ones.
static func catalogue() -> Array:
	return MODELS.keys() + MADE.keys()

static func trunk(name: String) -> float:
	return MADE[name] if MADE.has(name) else MODELS[name][3]

static func mesh_path(name: String) -> String:
	return DIR + name + ".res"
