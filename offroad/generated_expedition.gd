extends Node3D
## Exploration layer on the seed-generated road network.
## The world it plays in (endless_expedition.gd swaps in the endless one).
var H
const Models = preload("res://desert_battlefield/endless_models.gd")
const Props = preload("res://offroad/props.gd")
const SAVE := "user://roadtrip_expedition.json"
const CAPACITY := 80.0
var camp := Vector2.ZERO
# Four stops on the road and four at the ends of side roads.
const SITES := [
	["Údolie · zásoby", 0, 0.035, 0.075], ["Lom · sklad", 0, 0.23, 0.27],
	["Les · dielňa", 2, 0.68, 0.84], ["Les · sklad", 3, 0.68, 0.84],
	["Poľná cesta · zásoby", 0, 0.45, 0.49], ["Hory · sklad", 4, 0.68, 0.84],
	["Horská cesta · zásoby", 0, 0.75, 0.79], ["Odbočka · táborisko", 5, 0.68, 0.84],
]
var game: Node3D
var car: CharacterBody3D
var seed_value := 0
var fuel := 55.0
var condition := 100.0
var cargo := {"fuel": 10, "repair": 2, "tank": 0, "oil": 2, "coolant": 3}
var oil := 4.0
var coolant := 6.0
var reached_goal := false
var upgraded := false
var explored: Array = []
var finds_since_camp := 0
var completed_trips := 0
var sites: Array = []
var markers: Array = []
var message := "Vyrazte po zásoby. Zastavte pri oranžovom majáku a stlačte E."
var hud: Label
var save_clock := 0.0
var previous_position := Vector3.ZERO
var last_landing := 0
var save_path := SAVE
## Fuel per metre on asphalt with a road-tyred 4x2 (car.fuel_factor() scales it), and
## per second at full throttle.
var fuel_per_metre := 0.004
var fuel_per_second := 0.001
var oil_per_metre := 0.00025
var coolant_per_metre := 0.0004

func setup(root: Node3D) -> void:
	game = root
	car = root.lead
	seed_value = H.seed_value
	camp = Vector2(H.CAMP.x, H.CAMP.y)
	var explicit_seed := false
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--seed="):
			seed_value = int(arg.trim_prefix("--seed="))
			explicit_seed = true
	if not explicit_seed: _load_game()
	_generate()
	_build_hud()
	_apply_load()
	previous_position = car.position
	_update_hud()

func _generate() -> void:
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_value
	var start_road: PackedVector2Array = H.paths[0]
	var start_direction := (start_road[mini(6, start_road.size() - 1)] - start_road[0]).normalized()
	var camp_side := Vector2(-start_direction.y, start_direction.x)
	_marker(camp + camp_side * 12.0 + start_direction * 4.0, Color("4acbb7"), "TÁBOR · DOPLNENIE A OPRAVY")
	for i in SITES.size():
		var spec: Array = SITES[i]
		var path: PackedVector2Array = H.paths[spec[1]]
		var path_index := clampi(roundi(rng.randf_range(spec[2], spec[3]) * (path.size() - 1)), 0, path.size() - 1)
		var point: Vector2 = path[path_index]
		var reward := {"fuel": rng.randi_range(4, 8), "repair": rng.randi_range(1, 2), "tank": 0, "oil": rng.randi_range(0, 1), "coolant": rng.randi_range(0, 2)}
		if i == 2: reward.tank = 1
		sites.append({"name": spec[0], "point": point, "reward": reward})
		var tangent: Vector2 = (path[mini(path_index + 2, path.size() - 1)] - path[maxi(path_index - 2, 0)]).normalized()
		var side := Vector2(-tangent.y, tangent.x)
		# The beacon and its crate stand at the roadside, not in the lane.
		markers.append(_marker(point - side * 5.5, Color("e89c33"), str(spec[0])))
		if i in [1, 3, 5]:
			_build_site_barrack(point + side * 10.0, tangent)
	# Rockfall between the two ends of the generated bypass.
	var outer: PackedVector2Array = H.paths[0]
	var detour: PackedVector2Array = H.paths[1]
	var middle := (detour[0] + detour[-1]) * 0.5
	var index := 0
	var nearest := INF
	for i in outer.size():
		var d := outer[i].distance_squared_to(middle)
		if d < nearest:
			nearest = d
			index = i
	var p: Vector2 = outer[index]
	var tangent: Vector2 = (outer[mini(index + 2, outer.size() - 1)] - outer[maxi(index - 2, 0)]).normalized()
	var across := Vector2(-tangent.y, tangent.x)
	# The rockfall: a heap of boulders across the road (the world's rock
	# models), solid as one low wall.
	var barrier := StaticBody3D.new()
	barrier.position = Vector3(p.x, H.height_at(p.x, p.y), p.y)
	barrier.rotation.y = atan2(-tangent.x, -tangent.y)
	add_child(barrier)
	var rocks: Array = Props.names("rock_plain")
	for r in 9:
		var offset := across * rng.randf_range(-4.2, 4.2) + tangent * rng.randf_range(-1.2, 1.2)
		var size := rng.randf_range(0.9, 2.0)
		var rock := MeshInstance3D.new()
		rock.mesh = load(Props.mesh_path(rocks[rng.randi() % rocks.size()]))
		var at := p + offset
		var scale := size / 0.75
		rock.transform = Transform3D(Basis(Vector3.UP, rng.randf_range(0.0, TAU)).scaled(Vector3(scale, scale * rng.randf_range(0.6, 0.9), scale)),
			Vector3(at.x, H.height_at(at.x, at.y) - size * 0.2, at.y))
		add_child(rock)
	var collision := CollisionShape3D.new()
	var shape := BoxShape3D.new()
	shape.size = Vector3(9.0, 1.4, 2.6)
	collision.shape = shape
	collision.position.y = 0.7
	barrier.add_child(collision)
	_marker(p - tangent * 9.0 - across * 5.5, Color("ef4538"), "ZÁVAL · VRÁŤTE SA NA OBCHÁDZKU")
	var fork := (detour[mini(4, detour.size() - 1)] - detour[0]).normalized()
	_marker(detour[0] - Vector2(-fork.y, fork.x) * 6.0, Color("e6c552"), "ODBOČKA · OBCHÁDZKA ZÁVALU")
	_marker(outer[-1], Color("65c8ff"), "CIEĽ VÝPRAVY · ZASTAVTE A STLAČTE E")
	for hazard in [0.32, 0.75]:
		var j := clampi(roundi(hazard * (outer.size() - 1)), 2, outer.size() - 3)
		var direction := (outer[j + 2] - outer[j - 2]).normalized()
		var side := Vector2(-direction.y, direction.x)
		_build_road_rock(outer[j] + side * (2.6 if hazard < 0.5 else -2.6))

## A fallen boulder at the road's edge (a world rock model, solid).
func _build_road_rock(point: Vector2) -> void:
	var body := StaticBody3D.new()
	body.position = Vector3(point.x, H.height_at(point.x, point.y) + 0.3, point.y)
	var visual := MeshInstance3D.new()
	visual.mesh = load(Props.mesh_path("rock_plain_8"))
	visual.scale = Vector3(2.0, 1.6, 2.0)
	visual.position.y = -0.55
	visual.rotation.y = point.x
	body.add_child(visual)
	var shape := SphereShape3D.new()
	shape.radius = 0.8
	var collider := CollisionShape3D.new()
	collider.shape = shape
	body.add_child(collider)
	add_child(body)

func _build_site_barrack(point: Vector2, tangent: Vector2) -> Node3D:
	var building := Node3D.new()
	building.position = Vector3(point.x, H.height_at(point.x, point.y), point.y)
	building.rotation.y = atan2(-tangent.x, -tangent.y)
	add_child(building)
	Models.environment(building, "res://assets/models/stops/repair.tscn", "Shelter")
	var body := StaticBody3D.new()
	var collision := CollisionShape3D.new()
	var shape := BoxShape3D.new()
	shape.size = Vector3(6.5, 3.0, 4.5)
	collision.position.y = 1.5
	collision.shape = shape
	body.add_child(collision)
	building.add_child(body)
	return building

func _marker(point: Vector2, color: Color, title: String) -> Node3D:
	var marker := Node3D.new()
	marker.position = Vector3(point.x, H.height_at(point.x, point.y), point.y)
	var post := MeshInstance3D.new()
	var cylinder := CylinderMesh.new()
	cylinder.top_radius = 0.22
	cylinder.bottom_radius = 0.35
	cylinder.height = 4.0
	post.mesh = cylinder
	post.position.y = 2.0
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	material.emission_enabled = true
	material.emission = color
	material.emission_energy_multiplier = 0.7
	post.material_override = material
	marker.add_child(post)
	if color != Color("ef4538"):
		# A supply crate makes the beacon read as an actual exploration site.
		var crate := MeshInstance3D.new()
		var crate_mesh := BoxMesh.new()
		crate_mesh.size = Vector3(1.4, 1.1, 1.1)
		crate.mesh = crate_mesh
		crate.position = Vector3(2.6, 0.55, 0)
		var crate_material := StandardMaterial3D.new()
		crate_material.albedo_color = Color("776444")
		crate.material_override = crate_material
		marker.add_child(crate)
	var label := Label3D.new()
	label.text = title
	label.position.y = 5.0
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	label.font_size = 48
	label.no_depth_test = true
	marker.add_child(label)
	add_child(marker)
	return marker

func _build_hud() -> void:
	var layer := CanvasLayer.new()
	add_child(layer)
	# Top right, clear of the driving readout on the left.
	var panel := PanelContainer.new()
	panel.set_anchors_and_offsets_preset(Control.PRESET_TOP_RIGHT)
	panel.grow_horizontal = Control.GROW_DIRECTION_BEGIN
	panel.offset_left = -20.0
	panel.offset_right = -20.0
	panel.offset_top = 20.0
	layer.add_child(panel)
	hud = Label.new()
	hud.add_theme_font_size_override("font_size", 18)
	panel.add_child(hud)

func _process(delta: float) -> void:
	if game.paused: return
	var distance := Vector2(car.position.x - previous_position.x, car.position.z - previous_position.z).length()
	# Discontinuities (test teleport/reset/load) are not driven distance.
	if distance < 20.0: fuel = maxf(0.0, fuel - distance * fuel_per_metre * car.fuel_factor() - absf(car.last_throttle) * delta * fuel_per_second * (1.0 + 6.0 * car.spin_share()))
	if distance < 20.0:
		oil = maxf(0.0, oil - distance * oil_per_metre)
		coolant = maxf(0.0, coolant - distance * coolant_per_metre)
	previous_position = car.position
	car.set_meta("expedition_no_fuel", fuel <= 0.0)
	if car.landing_count != last_landing and car.landing_impact_speed > 5.0:
		condition = maxf(0.0, condition - (car.landing_impact_speed - 5.0) * 2.0)
	last_landing = car.landing_count
	car.set_meta("expedition_engine_factor", (0.5 + condition * 0.005) * (0.5 if oil < 0.5 or coolant < 0.5 else 1.0))
	_apply_load()
	save_clock += delta
	if save_clock > 10.0:
		_save_game()
		save_clock = 0.0
	_update_hud()

func _unhandled_key_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_E and not game.paused:
		interact()
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_B and not game.paused:
		service()

func _nearby() -> int:
	var pos := Vector2(car.position.x, car.position.z)
	if pos.distance_to(camp) < 18.0: return -2
	if pos.distance_to(H.paths[0][-1]) < 15.0: return -3
	for i in sites.size():
		if pos.distance_to(sites[i].point) < 12.0: return i
	return -1

func interact() -> void:
	if absf(car.speed) > 1.0:
		message = "Najprv zastavte auto."
		return
	var index := _nearby()
	if index == -2:
		var returned := finds_since_camp > 0
		var amount := mini(cargo.fuel, ceili((tank_capacity() - fuel)))
		fuel = minf(tank_capacity(), fuel + amount)
		cargo.fuel -= amount
		var repairs := mini(cargo.repair, ceili((100.0 - condition) / 20.0))
		condition = minf(100.0, condition + repairs * 20.0)
		cargo.repair -= repairs
		if cargo.tank > 0 and not upgraded:
			cargo.tank -= 1
			upgraded = true
		if returned:
			completed_trips += 1
			finds_since_camp = 0
		message = "%sTábor: doplnené %d l, opravy %d, nádrž %d l." % ["Výprava dokončená! " if returned else "", amount, repairs, tank_capacity()]
	elif index == -3:
		reached_goal = true
		message = "Cieľ dosiahnutý! Výpravu môžete ďalej preskúmať."
	elif index >= 0:
		if index in explored:
			message = "Toto miesto je už preskúmané."
		else:
			var reward: Dictionary = sites[index].reward
			var weight: float = reward.fuel + reward.repair * 5 + reward.tank * 20 + reward.oil + reward.coolant
			if cargo_weight() + weight > CAPACITY:
				message = "Náklad je plný. Vráťte sa do tábora."
				return
			for key in cargo: cargo[key] += reward[key]
			explored.append(index)
			finds_since_camp += 1
			if index < markers.size() and markers[index] != null: markers[index].visible = false
			message = "Nájdené: palivo %d l, opravy %d, olej %d l, chladiaca %d l%s." % [reward.fuel, reward.repair, reward.oil, reward.coolant, ", väčšia nádrž" if reward.tank else ""]
	else:
		if fuel <= 0.0:
			car.place_on_ground(Vector3(camp.x, 0, camp.y), 0.0)
			fuel = 5.0
			message = "Núdzový odťah do tábora: dostali ste 5 l paliva."
		else:
			message = "V blízkosti nie je miesto na interakciu."
	_apply_load()
	_save_game()
	_update_hud()

func tank_capacity() -> int:
	return 90 if upgraded else 60

func cargo_weight() -> float:
	return cargo.fuel + cargo.repair * 5.0 + cargo.tank * 20.0 + cargo.oil + cargo.coolant

func service() -> void:
	if absf(car.speed) > 1.0:
		message = "Pred servisom zastavte."
		return
	var f := mini(cargo.fuel, floori(tank_capacity() - fuel))
	var o := mini(cargo.oil, floori(5.0 - oil))
	var c := mini(cargo.coolant, floori(8.0 - coolant))
	fuel += f
	oil += o
	coolant += c
	cargo.fuel -= f
	cargo.oil -= o
	cargo.coolant -= c
	message = "Doplnené: palivo %d l, olej %d l, chladiaca %d l." % [f, o, c]
	_apply_load()
	_save_game()

func _apply_load() -> void:
	car.payload_kg = cargo_weight() + fuel * 0.75 + oil + coolant
	for i in mini(markers.size(), sites.size()):
		if markers[i] != null: markers[i].visible = i not in explored

func _update_hud() -> void:
	var near := _nearby()
	var prompt: String = "E · tábor: doplniť a opraviť" if near == -2 else ("E · dosiahnuť cieľ" if near == -3 else ("E · preskúmať: " + sites[near].name if near >= 0 and near not in explored else ("E · núdzový odťah do tábora" if fuel <= 0.0 else "")))
	var weather: String = game.test_grounds.weather.weather_text()
	var warning := "POZOR: lejak, mäkké cesty a stúpajúca rieka!" if game.test_grounds.weather.state == 3 else "Žltý maják: odbočka obchádza zával."
	if oil < 0.5 or coolant < 0.5: warning = "Málo oleja alebo chladiacej kvapaliny: znížený výkon!"
	hud.text = "VÝPRAVA · seed %d\nPalivo %.1f / %d l · Stav %.0f %%\nOlej %.1f / 5 l · Chladiaca %.1f / 8 l\nNáklad %.0f / %.0f kg · palivo %d · olej %d · chladiaca %d · opravy %d\nB · doplniť kvapaliny zo zásob\n%s\n%s\n%s\n%s" % [seed_value, fuel, tank_capacity(), condition, oil, coolant, cargo_weight(), CAPACITY, cargo.fuel, cargo.oil, cargo.coolant, cargo.repair, weather, warning, prompt, message]

func _save_game() -> void:
	# (Written aside and moved over, so a crash mid-write never loses the save.)
	var file := FileAccess.open(save_path + ".tmp", FileAccess.WRITE)
	if file == null:
		message = "Nepodarilo sa uložiť výpravu. Skontrolujte prístup k priečinku používateľa."
		return
	var data := {"version": 1, "world": H.CACHE_VERSION, "seed": seed_value, "fuel": fuel, "oil": oil, "coolant": coolant, "reached_goal": reached_goal, "condition": condition, "cargo": cargo, "upgraded": upgraded, "explored": explored, "finds_since_camp": finds_since_camp, "completed_trips": completed_trips, "x": car.position.x, "z": car.position.z, "heading": car.heading}
	data.merge(_save_more())
	file.store_string(JSON.stringify(data))
	file.close()
	DirAccess.rename_absolute(ProjectSettings.globalize_path(save_path + ".tmp"), ProjectSettings.globalize_path(save_path))

func _exit_tree() -> void:
	if game != null and car != null and is_instance_valid(car): _save_game()

func _load_game() -> void:
	if not FileAccess.file_exists(save_path): return
	var file := FileAccess.open(save_path, FileAccess.READ)
	if file == null: return
	var data = JSON.parse_string(file.get_as_text())
	if not data is Dictionary or data.get("version", 0) != 1: return
	# Saved in another version of the world (its land and roads differ for the
	# same seed): the seed carries on, the run starts afresh at the camp.
	if int(data.get("world", 0)) != H.CACHE_VERSION and not _keeps_place_in_new_world():
		seed_value = int(data.get("seed", seed_value))
		message = "Svet sa odvtedy zmenil: výprava začína znova v tábore."
		return
	seed_value = int(data.get("seed", seed_value))
	fuel = float(data.get("fuel", fuel))
	oil = float(data.get("oil", oil))
	coolant = float(data.get("coolant", coolant))
	reached_goal = bool(data.get("reached_goal", false))
	condition = float(data.get("condition", condition))
	var loaded_cargo: Dictionary = data.get("cargo", cargo)
	for key in cargo: cargo[key] = int(loaded_cargo.get(key, 0))
	upgraded = bool(data.get("upgraded", false))
	finds_since_camp = int(data.get("finds_since_camp", 0))
	completed_trips = int(data.get("completed_trips", 0))
	explored.clear()
	for index in data.get("explored", []): explored.append(int(index))
	car.place_on_ground(Vector3(float(data.get("x", camp.x)), 0, float(data.get("z", camp.y))), float(data.get("heading", 0)))
	_load_more(data)


## Does a run saved in another version of the world carry on where it was?
func _keeps_place_in_new_world() -> bool:
	return false

## More to save and restore (endless_expedition.gd: distance, record).
func _save_more() -> Dictionary:
	return {}

func _load_more(_data: Dictionary) -> void:
	pass
