shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;
#include "res://desert_battlefield/soil.gdshaderinc"
// Lesná vrchovina ground: the baked ground-kind map (highlands.gd) is blended
// between its four nearest texels, so materials meet softly where physics
// switches ground. Each ground draws a tileable texture layer (generated by
// build_props.gd) sampled twice at different scales and angles to hide the
// repeat. Shares the rut field and fine patches with the desert.
uniform sampler2D fine_tile_mask : filter_nearest, repeat_disable;
uniform bool fine_geometry = false;
instance uniform vec4 patch_bounds = vec4(-128.0, -128.0, 128.0, 128.0);
uniform sampler2D ground_map : filter_nearest, repeat_disable;
uniform float map_half = 180.0;
uniform float map_step = 0.5;
uniform float water_level = 0.0;
// Weather (offroad/weather.gd): soaked ground, fresh snow cover, frost.
uniform float wetness = 0.0;
uniform float snow_cover = 0.0;
// Depth of the snow pack (m): lifts the surface, see vertex().
uniform float snow_depth = 0.0;
uniform float frost = 0.0;
// Layers: 0 grass, 1 forest floor, 2 dirt, 3 mud (river bed), 4 gravel, 5 rock,
// 6 river bank (clay into mud), 7 trail mud, 8 snow, 9 ice, 10 sand (desert),
// 11 ploughed field (coloured by its crop, the look bits; endless_terrain.gd).
uniform sampler2DArray ground_albedo : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2DArray ground_normal : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
// Height of each layer (0..1) for the parallax relief: stones, clods and
// tufts appear to stand out of the ground near the camera.
uniform sampler2DArray ground_height : filter_linear_mipmap, repeat_enable;
// Asphalt (ROAD ground, layer 20: no texture array layer; the generated
// expeditions' first stretch).
uniform sampler2D asphalt_albedo : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
varying vec3 world;
varying vec3 world_normal;
varying vec3 base_normal;
// Ground chunks are flat grids lifted here to the baked 0.75 m height grid
// (highlands_world.gd); grid_step is the chunk's vertex spacing (0: the mesh
// carries its own heights, as the fine rut patches do).
uniform sampler2D ground_heights : filter_nearest, repeat_disable;
uniform float heights_half = 360.0;
uniform float heights_step = 0.75;
instance uniform float grid_step = 0.0;
// Which neighbours of an endless chunk are not made yet (bits: +x, +z, -x, -z, the +x +z corner):
// the ring still holds another tile's heights there, far above or below this one.
instance uniform int missing_sides = 0;
const int CHUNK_NODES = 80;
// Endless world (endless_world.gd): both maps are rings around the car, texel
// (x, z) holding the world texel at x, z modulo the map size (map_half and
// heights_half are 0 then). Otherwise they are clamped at the map's edge.
uniform bool wrap_maps = false;

ivec2 map_texel(ivec2 texel, ivec2 size) {
	// (From the texel's middle: 1920.0 / 960.0 may come out just under 2 on a GPU, and the row
	// on the ring's edge would read outside the map, as height zero: a chasm along it.)
	if (wrap_maps) { return texel - size * ivec2(floor((vec2(texel) + vec2(0.5)) / vec2(size))); }
	return clamp(texel, ivec2(0), size - 1);
}

float grid_height(ivec2 node) {
	return texelFetch(ground_heights, map_texel(node, textureSize(ground_heights, 0)), 0).r;
}

// The node itself, or the chunk's own nearest one where the neighbour is missing.
ivec2 kept_node(ivec2 node, ivec2 low, int missing) {
	ivec2 high = low + ivec2(CHUNK_NODES);
	if ((missing & 1) != 0 && node.x >= high.x) { node.x = high.x - 1; }
	if ((missing & 2) != 0 && node.y >= high.y) { node.y = high.y - 1; }
	if ((missing & 4) != 0 && node.x < low.x) { node.x = low.x; }
	if ((missing & 8) != 0 && node.y < low.y) { node.y = low.y; }
	if ((missing & 16) != 0 && node.x >= high.x && node.y >= high.y) { node = high - ivec2(1); }
	return node;
}

int kind_at(ivec2 texel) {
	return int(texelFetch(ground_map, map_texel(texel, textureSize(ground_map, 0)), 0).r * 255.0 + 0.5);
}

const int SAND = 0;
const int PACKED = 1;
const int ROAD = 2;
const int WET_ROAD = 11;
const int GRAVEL = 3;
const int MUD = 5;
const int WATER = 6;
const int ROCK = 7;
const int SNOW = 8;
const int ICE = 9;
const int GRASS = 10;
const int DIRT = 12;
const int FOREST = 13;

float hash12(vec2 p) {
	vec3 q = fract(vec3(p.xyx) * 0.1031);
	q += dot(q, q.yzx + 33.33);
	return fract((q.x + q.y) * q.z);
}
float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash12(i), hash12(i + vec2(1, 0)), u.x), mix(hash12(i + vec2(0, 1)), hash12(i + vec2(1, 1)), u.x), u.y);
}
float fbm(vec2 p) {
	return vnoise(p) * 0.55 + vnoise(p * 2.03 + 7.1) * 0.3 + vnoise(p * 4.1 - 3.7) * 0.15;
}

void vertex() {
	world = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	if (!fine_geometry && grid_step > 0.0) {
		ivec2 node = ivec2(round((world.xz + vec2(heights_half)) / heights_step));
		int s = int(round(grid_step / heights_step));
		ivec2 low = ivec2(round((MODEL_MATRIX[3].xz + vec2(heights_half)) / heights_step));
		int missing = missing_sides;
		float h = grid_height(kept_node(node, low, missing));
		VERTEX.y += h;
		world.y += h;
		NORMAL = normalize(vec3(grid_height(kept_node(node - ivec2(s, 0), low, missing)) - grid_height(kept_node(node + ivec2(s, 0), low, missing)), 2.0 * grid_step,
			grid_height(kept_node(node - ivec2(0, s), low, missing)) - grid_height(kept_node(node + ivec2(0, s), low, missing))));
	}
	// The terrain's own slope, before ruts tilt it (water and snow follow it).
	base_normal = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	float rut_depth = 0.0;
	// While a fine patch is still being built, the coarse mesh also follows the
	// shared rut field. Its mask discards it once the fine patch takes over.
	if (fine_geometry || (soil_enabled && grid_step > 0.0)) {
		rut_depth = sand_depth(world.xz);
		VERTEX.y -= rut_depth;
		NORMAL = sand_normal(world.xz, NORMAL);
	}
	// Snow pack: lifts the surface by its depth above the water, thinner on
	// roads (packed by traffic, so they stay visible as a trench).
	if (snow_depth > 0.005 && snow_cover > 0.0) {
		vec2 g = (world.xz + vec2(map_half)) / map_step;
		ivec2 base = ivec2(floor(g));
		vec2 f = fract(g);
		float open_ground = 0.0;
		for (int i = 0; i < 4; i++) {
			ivec2 o = ivec2(i & 1, i >> 1);
			int k = kind_at(base + o) & 15;
			float w = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
			open_ground += w * (k == WATER ? 0.0 : (k == DIRT || k == GRAVEL || k == MUD ? 0.55 : 1.0));
		}
		// (The same pack physics stands on, soil.gd snow_lift; tracks pressed into
		// it come with the rut depth above.)
		float lift = snow_depth * snow_cover * open_ground * smoothstep(water_level, water_level + 0.4, world.y);
		VERTEX.y += lift;
	}
	world_normal = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}


// Map byte: ground kind in the low 4 bits, look variant (1 = river bank) above.
int layer_of(int value) {
	int kind = value & 15;
	int look = value >> 4;
	if (kind == DIRT && look >= 2) { return 11; }
	if (kind == GRASS) { return 0; }
	if (kind == FOREST) { return 1; }
	if (kind == MUD) { return look == 1 ? 6 : 7; }
	if (kind == WATER) { return 3; }
	if (kind == ROAD || kind == WET_ROAD) { return 20; }
	if (kind == SAND || kind == PACKED) { return 10; }
	if (kind == GRAVEL) { return 4; }
	if (kind == ROCK) { return 5; }
	if (kind == SNOW) { return 8; }
	if (kind == ICE) { return 9; }
	return 2;
}

// Metres per texture repeat for each layer.
float tile(int layer) {
	return layer == 8 ? 4.0 : layer == 9 ? 3.5 : layer == 4 ? 2.2 : (layer == 5 ? 9.0 :(layer == 6 ? 4.2 : (layer == 7 ? 5.0 : (layer == 2 ? 3.0 : 3.6))));
}

// Relief depth of each layer in metres.
float relief_depth(int layer) {
	return layer == 5 ? 0.16 :(layer == 4 || layer == 7 ? 0.05 : (layer == 9 ? 0.01 : (layer == 2 || layer == 8 ? 0.04 : 0.03)));
}

// One layer sampled twice (second copy rotated and 2.7x larger) and mixed by a
// slow noise; returns albedo+roughness and the tangent-space normal. Where the
// noise picks one copy outright (most of the ground) only that one is fetched.
void sample_layer(int layer, vec2 p, float mixing, vec2 relief, out vec4 albedo, out vec3 normal) {
	float scale = 1.0 / tile(layer);
	vec2 a = p * scale;
	// Parallax: shift the lookup along the view by the texel's height, so raised
	// detail occludes what lies behind it (one step; only near the camera).
	if (relief.x != 0.0 || relief.y != 0.0) {
		float height = texture(ground_height, vec3(a, float(layer))).r;
		p += relief * (height - 0.5) * relief_depth(layer);
		a = p * scale;
	}
	vec2 b = mat2(vec2(0.8, 0.6), vec2(-0.6, 0.8)) * p * scale / 2.7 + 0.37;
	if (mixing < 0.01) {
		albedo = texture(ground_albedo, vec3(a, float(layer)));
		normal = texture(ground_normal, vec3(a, float(layer))).xyz * 2.0 - 1.0;
		return;
	}
	vec4 c2 = texture(ground_albedo, vec3(b, float(layer)));
	vec3 n2 = texture(ground_normal, vec3(b, float(layer))).xyz * 2.0 - 1.0;
	n2.xy = mat2(vec2(0.8, -0.6), vec2(0.6, 0.8)) * n2.xy;
	if (mixing > 0.99) {
		albedo = c2;
		normal = n2;
		return;
	}
	vec4 c1 = texture(ground_albedo, vec3(a, float(layer)));
	vec3 n1 = texture(ground_normal, vec3(a, float(layer))).xyz * 2.0 - 1.0;
	albedo = mix(c1, c2, mixing);
	normal = normalize(mix(n1, n2, mixing));
}

// Rock on steep ground: triplanar, so cliffs and banks do not stretch.
void sample_rock(vec3 w, vec3 n, out vec4 albedo, out vec3 normal_world) {
	vec3 blend = pow(abs(n), vec3(4.0));
	blend /= blend.x + blend.y + blend.z;
	float scale = 1.0 / tile(5);
	vec4 cx = texture(ground_albedo, vec3(w.zy * scale, 5.0));
	vec4 cy = texture(ground_albedo, vec3(w.xz * scale, 5.0));
	vec4 cz = texture(ground_albedo, vec3(w.xy * scale, 5.0));
	albedo = cx * blend.x + cy * blend.y + cz * blend.z;
	// Tone wandering over tens of metres, so the repeat does not show.
	albedo.rgb *= 0.72 + 0.62 * texture(ground_albedo, vec3(w.xz * 0.023 + w.y * 0.017, 5.0)).g * 2.0;
	vec3 tx =texture(ground_normal, vec3(w.zy * scale, 5.0)).xyz * 2.0 - 1.0;
	vec3 ty = texture(ground_normal, vec3(w.xz * scale, 5.0)).xyz * 2.0 - 1.0;
	vec3 tz = texture(ground_normal, vec3(w.xy * scale, 5.0)).xyz * 2.0 - 1.0;
	// Each projection's normal swizzled into world space, then blended.
	vec3 wx = vec3(tx.z * sign(n.x), tx.y, tx.x);
	vec3 wy = vec3(ty.x, ty.z * sign(n.y), ty.y);
	vec3 wz = vec3(tz.x, tz.y, tz.z * sign(n.z));
	normal_world = normalize(wx * blend.x + wy * blend.y + wz * blend.z + n * 0.5);
}

void fragment() {
	vec2 p = world.xz;
	if (fine_geometry && (p.x < patch_bounds.x || p.y < patch_bounds.y || p.x >= patch_bounds.z || p.y >= patch_bounds.w)) { discard; }
	vec2 field_p = p - soil_center;
	// (Kept a little way under the patches' edges, where their finer mesh would
	// leave cracks to the sky.)
	if (soil_enabled && !fine_geometry && max(abs(field_p.x), abs(field_p.y)) < 127.0) {
		vec2 mask_uv = (field_p + vec2(128.0)) / 256.0;
		float inset = 0.7 / 256.0;
		if (texture(fine_tile_mask, mask_uv + vec2(inset, inset)).r > 0.5 && texture(fine_tile_mask, mask_uv - vec2(inset, inset)).r > 0.5
			&& texture(fine_tile_mask, mask_uv + vec2(inset, -inset)).r > 0.5 && texture(fine_tile_mask, mask_uv + vec2(-inset, inset)).r > 0.5) { discard; }
	}
	vec3 geometric = normalize(world_normal);
	// Draw the same tracks on the coarse surface while its fine replacement is
	// being prepared, so fresh tracks do not appear only after a long delay.
	float rut_depth = sand_depth(p);
	// Shallow tyre impressions still reveal disturbed earth; depth is physical
	// and remains controlled by the soil field, not by this visual threshold.
	float rut = smoothstep(0.005, 0.10, rut_depth);
	// Snow shows even shallow tracks.
	float snow_rut = smoothstep(0.006, 0.06, rut_depth);
	float mixing = smoothstep(0.35, 0.65, fbm(p * 0.045));
	vec3 eye = CAMERA_POSITION_WORLD - world;
	float eye_distance = length(eye);
	eye /= eye_distance;
	vec2 relief = eye.xz / max(eye.y, 0.25) * (1.0 - smoothstep(12.0, 30.0, eye_distance));
	// The ground map is looked up through a noise warp (about ±0.8 m), so grounds
	// meet along ragged, fading edges instead of the map's straight texel steps.
	vec2 warp = (vec2(vnoise(p * 0.45), vnoise(p * 0.45 + 17.3)) - 0.5) * 1.2;
	// Bilinear blend of the four nearest ground texels (grid nodes on texels).
	vec2 g = (p + warp + vec2(map_half)) / map_step;
	ivec2 base = ivec2(floor(g));
	vec2 f = smoothstep(0.0, 1.0, fract(g));
	int kinds[4] = int[4](kind_at(base), kind_at(base + ivec2(1, 0)), kind_at(base + ivec2(0, 1)), kind_at(base + ivec2(1, 1)));
	float weights[4] = float[4]((1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y), (1.0 - f.x) * f.y, f.x * f.y);
	// Merge kinds drawn with the same layer, so each layer is sampled once.
	int layers[4];
	bool wet[4];
	for (int i = 0; i < 4; i++) {
		layers[i] = layer_of(kinds[i]);
		wet[i] = (kinds[i] & 15) == WATER;
	}
	for (int i = 1; i < 4; i++) {
		for (int j = 0; j < i; j++) {
			if (layers[i] == layers[j] && wet[i] == wet[j] && (kinds[i] >> 4) == (kinds[j] >> 4) && weights[j] > 0.0) { weights[j] += weights[i]; weights[i] = 0.0; break; }
		}
	}
	vec4 albedo = vec4(0.0);
	vec3 normal_world = vec3(0.0);
	// How the blended ground takes ruts and weather, weighted over its layers
	// (never decided by one dominant texel, which would draw stair steps):
	// soft soil, mud churned up by rain, soaking, how late snow settles, baked
	// snow, ice, hard ground that frost glazes, turf that gathers hoar frost.
	float soil_w = 0.0;
	float sand_w = 0.0;
	float mud_w = 0.0;
	float churn_w = 0.0;
	float soak_w = 0.0;
	float settle_w = 0.0;
	float snow_w = 0.0;
	float ice_w = 0.0;
	float hard_w = 0.0;
	float turf_w = 0.0;
	float steep = smoothstep(0.45, 0.7, 1.0 - geometric.y);
	for (int i = 0; i < 4; i++) {
		if (weights[i] <= 0.001) { continue; }
		int layer = layers[i];
		float w = weights[i];
		vec4 a;
		vec3 n;
		if (layer == 20) {
			vec3 small_asphalt = texture(asphalt_albedo, p / 5.0).rgb;
			vec3 broad_asphalt = texture(asphalt_albedo, (p.yx + vec2(17.0, 9.0)) / 13.5).rgb;
			a = vec4(mix(small_asphalt, broad_asphalt, 0.32), 0.85);
			n = geometric;
		} else if (layer == 5 && steep > 0.0) {
			sample_rock(world, geometric, a, n);
		} else {
			vec3 t;
			sample_layer(layer, p, mixing, relief, a, t);
			if (layer == 6) {
				// River bank: wet mud at the waterline drying into clay about a
				// metre higher, along a slightly ragged line.
				vec4 mud;
				vec3 mud_normal;
				sample_layer(3, p, mixing, relief, mud, mud_normal);
				float dry = smoothstep(0.15, 1.1, world.y - water_level + (fbm(p * 0.35) - 0.5) * 0.5);
				a = mix(mud, a, dry);
				t = normalize(mix(mud_normal, t, dry));
			}
			// Tangent space on the ground: x along world X, y along world Z.
			n = normalize(geometric + vec3(t.x, 0.0, t.y) * 1.25);
		}
		int look = kinds[i] >> 4;
		if (layer == 11) {
			// A field from afar is the colour of its crop; close by, the soil shows.
			vec3 crop = look == 2 ? vec3(0.13, 0.25, 0.06) : look == 3 ? vec3(0.74, 0.62, 0.26) : look == 4 ? vec3(0.8, 0.6, 0.2) : look == 5 ? vec3(0.78, 0.69, 0.1) : look == 6 ? vec3(0.2, 0.28, 0.08) : a.rgb;
			float luma = dot(a.rgb, vec3(0.33)) * 3.2;
			a.rgb = mix(a.rgb, crop * (0.7 + 0.3 * luma), mix(0.55, 0.9, smoothstep(10.0, 60.0, eye_distance)));
		} else if (layer == 0 && look == 1) {
			// Dry steppe grass.
			a.rgb = mix(a.rgb, vec3(0.58, 0.48, 0.23) * (0.55 + 1.5 * dot(a.rgb, vec3(0.33))), 0.8);
		}
		if (wet[i]) {
			// River bed: the mud layer, darker and smooth under the water.
			a.rgb *= 0.7;
			a.a = 0.15;
		}
		albedo += a * w;
		normal_world += n * w;
		bool soft = layer != 4 && layer != 5 && layer != 8 && layer != 9 && layer != 20;
		soil_w += soft ? w : 0.0;
		sand_w += layer == 10 ? w : 0.0;
		mud_w += (layer == 3 || layer == 6 || layer == 7) ? w : 0.0;
		churn_w += w * (layer == 2 || layer == 11 ? 0.8 : (layer == 1 ? 0.35 : (layer == 0 ? 0.15 : 0.0)));
		soak_w += w * (layer == 20 ? 0.45 : (layer >= 8 && layer != 11 ? 0.0 : (layer == 2 || layer == 11 ? 1.0 : (layer == 0 ? 0.6 : 0.75))));
		settle_w += w * (layer <= 1 ? 0.0 : (layer == 5 ? 0.3 : 0.18));
		snow_w += layer == 8 ? w : 0.0;
		ice_w += layer == 9 ? w : 0.0;
		hard_w += (layer == 4 || layer == 5 || layer == 2 || layer == 20) ? w : 0.0;
		turf_w += layer <= 1 ? w : 0.0;
	}
	// Tyres sinking into turf, forest floor or dirt churn up the wet soil below;
	// rain turns dirt roads (and less so forest floor and turf) to mud.
	// (Sand has no wet soil below: dug up it is only darker sand.)
	float churn = max(rut * 0.8 * max(soil_w - sand_w, 0.0) * (1.0 - snow_cover), wetness * churn_w);
	if (churn > 0.01) {
		vec4 churned;
		vec3 churned_normal;
		sample_layer(7, p, mixing, relief, churned, churned_normal);
		// Churned soil is damp, not a mirror (the layer's glossy pools stay out).
		churned.a = max(churned.a, 0.6);
		albedo = mix(albedo, churned, churn);
	}
	// Broad colour variation so large areas do not look printed.
	float macro = fbm(p * 0.013);
	// (Hardly on baked snow: large tone patches on white read as cloud shadows.)
	albedo.rgb *= mix(1.0, mix(0.86, 1.12, macro), 1.0 - snow_w * 0.85);
	albedo.rgb = mix(albedo.rgb, albedo.rgb * vec3(1.06, 1.0, 0.86), smoothstep(0.55, 0.8, fbm(p * 0.006 + 3.0)) * 0.6);
	// Ruts: churned, darker and damper soil, smoothed by the tyres; packed snow
	// in snow.
	float pressed = mix(rut, snow_rut, snow_w);
	// (Sand goes darker the deeper it is dug, without turning to mud.)
	vec3 dug_sand = mix(vec3(0.74, 0.66, 0.56), vec3(0.44, 0.37, 0.3), smoothstep(0.02, 0.35, rut_depth));
	albedo.rgb = mix(albedo.rgb, albedo.rgb * mix(mix(vec3(0.62, 0.56, 0.5), dug_sand, sand_w), vec3(0.76, 0.8, 0.88), snow_w), pressed * 0.85);
	albedo.a = mix(albedo.a, albedo.a * 0.8, rut);
	normal_world = normalize(mix(normal_world, geometric, rut * 0.6 * (1.0 - snow_cover)));
	// The walls of a rut catch the light and the shade: that is what shows how deep it is.
	// White on white shows a groove by nothing else.
	if (rut_depth > 0.008 && eye_distance < 45.0) { normal_world = normalize(mix(normal_world, sand_normal(p, geometric), 1.0 - smoothstep(30.0, 45.0, eye_distance))); }
	// Rain: soaked ground darkens and turns satin (not mirror); water gathers in
	// hollows and ruts on level soil, and only there does it shine.
	float damp = wetness * soak_w;
	albedo.rgb *= mix(1.0, 0.62, damp);
	albedo.a = mix(albedo.a, max(albedo.a * 0.7, 0.48), damp);
	// Water only rests on level ground (the terrain's own slope, not a rut wall):
	// on a slope it runs off, so ruts there stay wet mud.
	float level = smoothstep(0.985, 0.996, base_normal.y);
	float hollow = smoothstep(0.6, 0.7, fbm(p * 0.09 + 11.0)) * level;
	// Ruts hold standing water only where the ground is waterlogged: close to
	// the river or pond level, or in mud. Elsewhere rain turns them to mud.
	float near_water = 1.0 - smoothstep(0.4, 1.8, world.y - water_level);
	float holds = max(near_water, mud_w * 0.7);
	// In a rut it pools in the bottom only, not up its walls.
	float rut_pool = smoothstep(0.07, 0.15, rut_depth) * level;
	float puddle = smoothstep(0.35, 0.6, wetness * clamp(max(hollow, rut_pool) * holds, 0.0, 1.0)) * (1.0 - snow_w - ice_w);
	albedo.rgb = mix(albedo.rgb, albedo.rgb * 0.45 + vec3(0.02, 0.025, 0.03), puddle);
	albedo.a = mix(albedo.a, 0.06, puddle);
	// Standing water is flat, whatever the ground beneath it does.
	normal_world = normalize(mix(normal_world, vec3(0.0, 1.0, 0.0), puddle));
	// Fresh snow settles patch by patch: first on turf and forest floor, later on
	// bare dirt, roads and rock (warmer, swept), never on steep faces; each spot
	// whitens once the fall passes its own threshold.
	float settle = fbm(p * 0.3) * 0.45 + fbm(p * 1.6 + 4.0) * 0.35 + settle_w;
	float cover = smoothstep(settle - 0.05, settle + 0.05, snow_cover * 1.25) * smoothstep(0.55, 0.85, base_normal.y) * (1.0 - snow_w);
	// Tyres press the snow down to a grey-blue crust, not through it: fresh tracks stay
	// white grooves (the vertex lift dips there) rather than stripes of what lies beneath.
	cover *= 1.0 - snow_rut * 0.12 * (1.0 - smoothstep(0.01, 0.10, snow_depth));
	if (cover > 0.001) {
		vec4 fresh;
		vec3 fresh_normal;
		sample_layer(8, p, mixing, relief, fresh, fresh_normal);
		fresh.rgb *= mix(vec3(1.0), vec3(0.86, 0.90, 0.96), snow_rut);
		// The rut walls catch shade on the far side from the light: steepen the
		// snow normal by the rut so the dent reads as a groove.
		fresh_normal.xy *= 1.0 + snow_rut * 2.0;
		albedo = mix(albedo, fresh, cover);
		normal_world = normalize(mix(normal_world, normalize(geometric + vec3(fresh_normal.x, 0.0, fresh_normal.y) * 0.6), cover));
	}
	// Frost: hoar on turf and soil; wet hard ground and roads glaze over.
	float hoar = frost * (1.0 - cover) * mix(0.25, 0.45, turf_w);
	albedo.rgb = mix(albedo.rgb, vec3(0.82, 0.86, 0.9), hoar * (0.6 + 0.4 * fbm(p * 0.7)));
	float glaze = frost * clamp(wetness * 1.6, 0.0, 1.0) * (1.0 - cover) * hard_w;
	albedo.a = mix(albedo.a, 0.2, glaze * 0.7);
	// Nothing but puddles, glaze and ice is allowed to look polished.
	float polish = clamp(max(max(puddle, glaze * 0.6), ice_w), 0.0, 1.0);
	ALBEDO = albedo.rgb;
	ROUGHNESS = max(albedo.a, mix(0.5, 0.04, polish));
	SPECULAR = mix(0.2, 0.4, polish);
	NORMAL = normalize((VIEW_MATRIX * vec4(normal_world, 0.0)).xyz);
}
